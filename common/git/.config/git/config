[user]
  name = Mike Hoskins
  email = me@deadlysyn.com
  signingkey = /home/mrh/.ssh/id_ed25519.pub
[core]
  editor = nvim
[color]
  status = auto
  branch = auto
  interactive = auto
  diff = auto
  ui = true
[alias]
  lg = log --graph --pretty=format:'%Cred%h%Creset -%C(yellow)%d%Creset %s %Cgreen(%cr) %C(bold blue)<%an>%Creset' --abbrev-commit
[pull]
  rebase = false
[init]
  defaultBranch = main
[url "ssh://git@github.com/"]
  insteadOf = https://github.com/
[gpg]
  format = ssh
[commit]
  gpgsign = true
